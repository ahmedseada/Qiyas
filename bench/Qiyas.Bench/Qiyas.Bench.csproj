<Project Sdk="Microsoft.NET.Sdk">
  <!-- Qiyas, the bench: the proofs first, then Adad measured against the other subjects. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Qiyas</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Adad\Adad.csproj" />
    <ProjectReference Include="..\..\src\Qiyas.Checks\Qiyas.Checks.csproj" />
    <!-- The contracts and shared types, and the devices. -->
    <Using Include="Adad.Abstraction" />
    <Using Include="Adad.Cpu" />
    <Using Include="Adad.Cuda" />
    <!-- The stored integer types by their names, as inside the library (not System's). -->
    <Using Include="Adad.Abstraction.Int64" Alias="Int64" />
    <Using Include="Adad.Abstraction.Int32" Alias="Int32" />
    <Using Include="Adad.Abstraction.Int16" Alias="Int16" />
    <Using Include="Adad.Abstraction.UInt64" Alias="UInt64" />
    <Using Include="Adad.Abstraction.UInt32" Alias="UInt32" />
    <Using Include="Adad.Abstraction.UInt16" Alias="UInt16" />
  </ItemGroup>
</Project>
